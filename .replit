modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Music AI Worker"

[[workflows.workflow]]
name = "Music AI Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python services/music-ai-worker/smoke_test.py && uv run uvicorn app:app --app-dir services/music-ai-worker --host 0.0.0.0 --port 8008"
waitForPort = 8008

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["ffmpeg-full", "libgccjit", "libsndfile", "libxcrypt", "oneDNN", "pkg-config", "portmidi", "re2", "xsimd"]

[userenv]

[userenv.development]
BASIC_PITCH_API_URL = "http://127.0.0.1:8008"
DEMUCS_API_URL = "http://127.0.0.1:8008"
ACE_STEP_API_URL = "https://windot100--ace-step.modal.run"
MUSIC_PROVIDER_ACE_STEP_CHECKPOINT_SHA256 = "d3f38c0fb68bd980d4f49c469f68bce9a94216cef614a85f7cea34fc98bd8b4e"
MUSIC_PROVIDER_ACE_STEP_CONTAINER_DIGEST = "sha256:c24957d8b4fc84f6e676675fd00ccbd3d8cf5beb3464eb80ab60e75057c08eae"
MUSIC_PROVIDER_ACE_STEP_MODEL_VERSION = "ace-step-1.5-base"
MUSIC_PROVIDER_ACE_STEP_MODAL_IMAGE_ID = "im-JZ7V3KgPwL1NLT6Q6bZfQe"
MUSIC_PROVIDER_ACE_STEP_SOURCE_IMAGE_DIGEST = "sha256:c24957d8b4fc84f6e676675fd00ccbd3d8cf5beb3464eb80ab60e75057c08eae"
MUSIC_PROVIDER_ACE_STEP_URL = "https://windot100--ace-step.modal.run"
