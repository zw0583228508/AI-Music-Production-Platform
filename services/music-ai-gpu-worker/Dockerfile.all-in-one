# Modal image identity: ALL_IN_ONE. Keep synchronized with Dockerfile.
ARG CUDA_IMAGE=nvidia/cuda@sha256:2fcc4280646484290cc50dce5e65f388dd04352b07cbe89a635703bd1f9aedb6
FROM ${CUDA_IMAGE}
ARG PROVIDER_REQUIREMENTS=requirements-all-in-one.txt
ARG CUDA_RUNTIME=12.4.1
ARG PYTORCH_SPEC=torch==2.5.1+cu124
ARG TORCHVISION_SPEC=torchvision==0.20.1+cu124
ARG TORCHAUDIO_SPEC=torchaudio==2.5.1+cu124
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG TRANSFORMERS_SPEC=transformers==4.48.3
ARG ACCELERATE_SPEC=accelerate==1.3.0

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUSIC_GPU_CHECKPOINT_ROOT=/var/lib/music-ai-gpu/models \
    MUSIC_GPU_SOURCE_ROOT=/provenance \
    MUSIC_GPU_CUDA_VERSION=${CUDA_RUNTIME}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg git libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv@sha256:90daa0b4d74ea55c7b8e06d25d3826b1eac66e7994387248e6173dd2b66668e2 /uv /uvx /bin/
RUN uv python install 3.11.11
RUN uv venv --python 3.11.11 /opt/music-ai-venv
ENV PATH="/opt/music-ai-venv/bin:${PATH}"
RUN uv pip install --python /opt/music-ai-venv/bin/python \
    "${PYTORCH_SPEC}" "${TORCHVISION_SPEC}" "${TORCHAUDIO_SPEC}" \
    --index-url "${TORCH_INDEX_URL}"
RUN uv pip install --python /opt/music-ai-venv/bin/python \
    fastapi==0.141.1 uvicorn==0.52.4 pydantic==2.13.5 \
    "${TRANSFORMERS_SPEC}" "${ACCELERATE_SPEC}"

WORKDIR /app
COPY services/music-ai-gpu-worker/runners/requirements-all-in-one.txt /tmp/provider-requirements.txt
RUN uv pip install --python /opt/music-ai-venv/bin/python \
      -r /tmp/provider-requirements.txt
RUN mkdir -p /app/runners /provenance/runners
COPY services/music-ai-gpu-worker/app.py services/music-ai-gpu-worker/modal_config.py services/music-ai-gpu-worker/model_manifest.json /app/
COPY services/music-ai-gpu-worker/runners/__init__.py services/music-ai-gpu-worker/runners/common.py services/music-ai-gpu-worker/runners/all_in_one.py /app/runners/
COPY services/music-ai-gpu-worker/Dockerfile.ace-step services/music-ai-gpu-worker/Dockerfile.bs-roformer services/music-ai-gpu-worker/Dockerfile.mt3 services/music-ai-gpu-worker/Dockerfile.all-in-one services/music-ai-gpu-worker/app.py services/music-ai-gpu-worker/modal_config.py services/music-ai-gpu-worker/modal_app.py services/music-ai-gpu-worker/checkpoint_bootstrap.py services/music-ai-gpu-worker/model_manifest.json /provenance/
COPY services/music-ai-gpu-worker/runners/__init__.py services/music-ai-gpu-worker/runners/common.py services/music-ai-gpu-worker/runners/ace_step.py services/music-ai-gpu-worker/runners/bs_roformer.py services/music-ai-gpu-worker/runners/mt3.py services/music-ai-gpu-worker/runners/all_in_one.py services/music-ai-gpu-worker/runners/requirements-ace-step.txt services/music-ai-gpu-worker/runners/requirements-bs-roformer.txt services/music-ai-gpu-worker/runners/requirements-mt3.txt services/music-ai-gpu-worker/runners/requirements-all-in-one.txt /provenance/runners/
RUN groupadd --system music-ai && useradd --system --gid music-ai --home /app music-ai \
    && mkdir -p /var/lib/music-ai-gpu/models \
    && chown -R music-ai:music-ai /app /var/lib/music-ai-gpu
EXPOSE 8009
USER music-ai
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8009"]